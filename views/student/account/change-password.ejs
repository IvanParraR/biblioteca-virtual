<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head') %>
<body>
  <%- include('../../partials/nav-student') %>
  <% if (!forced) { %><%- include('../../partials/nav-student-account') %><% } else { %><div class="container" style="padding-top:24px;"></div><% } %>

  <div class="container" style="padding-bottom:60px; max-width:480px;">
    <% if (forced) { %>
      <div class="alert alert-error">Tienes una contraseña temporal — define una nueva antes de seguir usando tu cuenta.</div>
    <% } %>
    <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>
    <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

    <h1 style="margin-bottom:18px;">Cambiar contraseña</h1>

    <div class="form-card">
      <form action="/mi-cuenta/contrasena" method="POST">
        <% if (!forced) { %>
          <div class="field" style="margin-bottom:14px;">
            <label for="current_password">Contraseña actual</label>
            <input type="password" id="current_password" name="current_password" required>
          </div>
        <% } %>
        <div class="field" style="margin-bottom:14px;">
          <label for="new_password">Contraseña nueva</label>
          <input type="password" id="new_password" name="new_password" required minlength="8" placeholder="Mínimo 8 caracteres">
          <span class="field-hint">Con al menos una mayúscula, un número y un carácter especial (ej. !@#$%&*).</span>
        </div>
        <div class="field" style="margin-bottom:18px;">
          <label for="confirm_password">Confirmar contraseña nueva</label>
          <input type="password" id="confirm_password" name="confirm_password" required minlength="8">
        </div>
        <button type="submit" class="btn btn-gold btn-block">Guardar contraseña</button>
      </form>
    </div>
  </div>

  <%- include('../../partials/footer') %>
</body>
</html>
