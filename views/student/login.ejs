<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Iniciar sesión</h1>
      <p class="login-sub">Entra a tu cuenta de estudiante.</p>

      <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>
      <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>

      <form action="/iniciar-sesion" method="POST">
        <div class="field" style="margin-bottom:14px;">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" required autofocus placeholder="tu@correo.com">
        </div>
        <div class="field" style="margin-bottom:22px;">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Iniciar sesión</button>
      </form>

      <p style="text-align:center; margin-top:16px; font-size:0.85rem;">
        <a href="/recuperar-contrasena" style="color:var(--forest-700); font-weight:600;">¿Olvidaste tu contraseña?</a>
      </p>
      <p style="text-align:center; margin-top:8px; font-size:0.85rem;">
        ¿No tienes cuenta? <a href="/registro" style="color:var(--forest-700); font-weight:600;">Regístrate</a>
      </p>
      <p style="text-align:center; margin-top:8px; font-size:0.82rem;">
        <a href="/" style="color:var(--ink-400);">← Volver al catálogo</a>
      </p>
    </div>
  </div>
</body>
</html>
