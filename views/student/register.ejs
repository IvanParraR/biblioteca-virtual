<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card" style="max-width:460px;">
      <div class="brand-mark">B</div>
      <h1>Crear cuenta</h1>
      <p class="login-sub">Regístrate para prestar libros, ver tu historial y hacer seguimiento de tus préstamos.</p>

      <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>
      <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>

      <form action="/registro" method="POST">
        <div class="field" style="margin-bottom:14px;">
          <label for="full_name">Nombre completo *</label>
          <input type="text" id="full_name" name="full_name" required placeholder="Ej. Ana María Torres">
        </div>
        <div class="field" style="margin-bottom:14px;">
          <label for="student_code">Código / carné (si lo tienes)</label>
          <input type="text" id="student_code" name="student_code" placeholder="Ej. 2026-0143">
          <span class="field-hint">Si la biblioteca ya te tiene registrado con este código, tu historial de préstamos anterior queda ligado a tu cuenta nueva.</span>
        </div>
        <div class="field" style="margin-bottom:14px;">
          <label for="grade">Grado</label>
          <select id="grade" name="grade">
            <option value="">Selecciona tu grado…</option>
            <% grades.forEach(g => { %><option value="<%= g %>"><%= g %></option><% }) %>
          </select>
        </div>
        <div class="field" style="margin-bottom:14px;">
          <label for="email">Correo *</label>
          <input type="email" id="email" name="email" required placeholder="tu@correo.com">
        </div>
        <div class="field" style="margin-bottom:22px;">
          <label for="password">Contraseña *</label>
          <input type="password" id="password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres">
          <span class="field-hint">Con al menos una mayúscula, un número y un carácter especial (ej. !@#$%&*).</span>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Crear cuenta</button>
      </form>

      <p style="text-align:center; margin-top:16px; font-size:0.85rem;">
        ¿Ya tienes cuenta? <a href="/iniciar-sesion" style="color:var(--forest-700); font-weight:600;">Inicia sesión</a>
      </p>
      <p style="text-align:center; margin-top:8px; font-size:0.82rem;">
        <a href="/" style="color:var(--ink-400);">← Volver al catálogo</a>
      </p>
    </div>
  </div>
</body>
</html>
