<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Recuperar contraseña</h1>
      <p class="login-sub">Te enviaremos una contraseña temporal a tu correo.</p>

      <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>
      <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>

      <form action="/recuperar-contrasena" method="POST">
        <div class="field" style="margin-bottom:22px;">
          <label for="email">Correo</label>
          <input type="email" id="email" name="email" required autofocus placeholder="tu@correo.com">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Enviar contraseña temporal</button>
      </form>

      <p style="text-align:center; margin-top:16px; font-size:0.82rem;">
        <a href="/iniciar-sesion" style="color:var(--forest-700); font-weight:600;">← Volver a iniciar sesión</a>
      </p>
    </div>
  </div>
</body>
</html>
