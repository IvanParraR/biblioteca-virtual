<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Recuperar contraseña por correo</h1>
      <p class="login-sub">Te enviaremos una contraseña temporal al correo registrado en tu cuenta.</p>

      <% if (errorMsg && errorMsg.length) { %>
        <div class="alert alert-error"><%= errorMsg[0] %></div>
      <% } %>
      <% if (successMsg && successMsg.length) { %>
        <div class="alert alert-success"><%= successMsg[0] %></div>
      <% } %>

      <form action="/admin/forgot-password-email" method="POST">
        <div class="field" style="margin-bottom:22px;">
          <label for="identifier">Usuario o correo</label>
          <input type="text" id="identifier" name="identifier" required autofocus placeholder="Tu usuario o tu correo">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Enviar contraseña temporal</button>
      </form>

      <p style="text-align:center; margin-top:18px; font-size:0.82rem; color:var(--ink-400);">
        ¿Prefieres responder tu pregunta de seguridad en su lugar?<br>
        <a href="/admin/forgot-password" style="color:var(--forest-700); font-weight:600;">Recuperar con pregunta de seguridad</a>
      </p>

      <p style="text-align:center; margin-top:14px; font-size:0.82rem;">
        <a href="/admin/login" style="color:var(--forest-700); font-weight:600;">← Volver a iniciar sesión</a>
      </p>
    </div>
  </div>
</body>
</html>
