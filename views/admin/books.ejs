<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav-admin') %>

  <div class="admin-page-head">
    <div>
      <h1 style="margin-bottom:2px;">Gestionar libros</h1>
      <p style="color:var(--ink-600); font-size:0.9rem;"><%= total %> libro<%= total === 1 ? '' : 's' %> en el catálogo.</p>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <% const exportQs = new URLSearchParams(filters).toString(); %>
      <a href="/admin/books/export/excel?<%= exportQs %>" class="btn btn-outline" title="Exporta el catálogo con los filtros actuales">Exportar Excel</a>
      <a href="/admin/books/export/pdf?<%= exportQs %>" class="btn btn-outline" title="Exporta el catálogo con los filtros actuales">Exportar PDF</a>
      <a href="/admin/books/import" class="btn btn-outline">Importar CSV</a>
      <a href="/admin/books/new" class="btn btn-gold">+ Agregar libro</a>
    </div>
  </div>

  <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>
  <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

  <form action="/admin/books" method="GET" class="filter-bar">
    <div class="field" style="grid-column: span 2;">
      <label for="q">Buscar</label>
      <input type="text" id="q" name="q" value="<%= filters.q %>" placeholder="Título, autor o ISBN…">
    </div>
    <div class="field">
      <label for="category">Categoría</label>
      <select id="category" name="category">
        <option value="">Todas</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(filters.category) === String(c.id) ? 'selected' : '' %>><%= c.category %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="availability">Estado</label>
      <select id="availability" name="availability">
        <option value="">Todos</option>
        <option value="disponible" <%= filters.availability === 'disponible' ? 'selected' : '' %>>Disponible</option>
        <option value="prestado" <%= filters.availability === 'prestado' ? 'selected' : '' %>>Prestado</option>
        <option value="solo_biblioteca" <%= filters.availability === 'solo_biblioteca' ? 'selected' : '' %>>Solo biblioteca</option>
        <option value="no_disponible" <%= filters.availability === 'no_disponible' ? 'selected' : '' %>>No disponible</option>
      </select>
    </div>
    <div class="field">
      <button type="submit" class="btn btn-primary btn-block">Filtrar</button>
    </div>
  </form>

  <% if (books.length > 0) { %>
    <div class="bulk-bar" id="bulk-bar">
      <span id="bulk-count">0 seleccionados</span>
      <select id="bulk-category-select">
        <option value="">Elegir categoría…</option>
        <% categories.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.category %></option>
        <% }) %>
      </select>
      <button type="button" id="bulk-apply-category" class="btn btn-outline btn-sm">Cambiar categoría</button>
      <button type="button" id="bulk-delete-btn" class="btn btn-danger btn-sm">Eliminar seleccionados</button>
    </div>

    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width:36px;"><input type="checkbox" id="select-all" aria-label="Seleccionar todos"></th>
            <th>Portada</th><th>Título</th><th>Autor</th><th>ISBN</th><th>Categoría</th>
            <th>Copias</th><th>Estado</th><th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(b => { %>
            <tr>
              <td data-label="Seleccionar"><input type="checkbox" class="row-checkbox" value="<%= b.id %>"></td>
              <td data-label="Portada">
                <div class="table-cover"><% if (b.cover_url) { %><img src="<%= b.cover_url %>" alt=""><% } %></div>
              </td>
              <td data-label="Título" class="table-title-cell"><%= b.title %></td>
              <td data-label="Autor"><%= b.author %></td>
              <td data-label="ISBN" style="font-family:var(--font-mono); font-size:0.8rem;"><%= b.isbn %></td>
              <td data-label="Categoría"><%= b.category %></td>
              <td data-label="Copias"><%= b.available_copies %> / <%= b.total_copies %></td>
              <td data-label="Estado"><span class="badge badge-<%= b.status %>"><%= b.status_label %></span></td>
              <td data-label="Acciones">
                <div class="actions-cell">
                  <a href="/libro/<%= b.id %>" target="_blank" class="btn btn-outline btn-sm">Ver</a>
                  <a href="/admin/books/<%= b.id %>/edit" class="btn btn-outline btn-sm">Editar</a>

                  <form action="/admin/books/<%= b.id %>/add-copies" method="POST" style="display:inline; margin:0;">
                    <input type="hidden" name="amount" value="1">
                    <button type="submit" class="btn btn-outline btn-sm" title="Marcar 1 copia como disponible (ej. se devolvió)" <%= b.available_copies >= b.total_copies ? 'disabled' : '' %>>+1</button>
                  </form>
                  <form action="/admin/books/<%= b.id %>/remove-copies" method="POST" style="display:inline; margin:0;">
                    <input type="hidden" name="amount" value="1">
                    <button type="submit" class="btn btn-outline btn-sm" title="Marcar 1 copia como no disponible (ej. se prestó)" <%= b.available_copies === 0 ? 'disabled' : '' %>>-1</button>
                  </form>

                  <button type="button" class="btn btn-danger btn-sm js-delete-trigger" data-title="<%= b.title %>" data-action="/admin/books/<%= b.id %>/delete">Eliminar</button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Formularios ocultos para las acciones masivas — se llenan por
         JS con los IDs seleccionados justo antes de enviarlos. No
         envuelven la tabla (los formularios no pueden anidarse en
         HTML, y cada fila ya tiene sus propios formularios de +1/-1). -->
    <form id="bulk-delete-form" action="/admin/books/bulk-delete" method="POST" style="display:none;"></form>
    <form id="bulk-category-form" action="/admin/books/bulk-category" method="POST" style="display:none;">
      <input type="hidden" name="category_id" id="bulk-category-hidden-input">
    </form>

    <% if (totalPages > 1) { %>
      <nav class="pagination" aria-label="Paginación">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% const qs = new URLSearchParams({...filters, page: p}).toString(); %>
          <% if (p === currentPage) { %><span class="current"><%= p %></span>
          <% } else { %><a href="/admin/books?<%= qs %>"><%= p %></a><% } %>
        <% } %>
      </nav>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5a2 2 0 012-2h9v18H6a2 2 0 01-2-2V5z"/><path d="M15 3h3a2 2 0 012 2v14a2 2 0 01-2 2h-3"/></svg>
      <h3>No hay libros que coincidan</h3>
      <p>Agrega tu primer libro o ajusta los filtros de búsqueda.</p>
      <div style="margin-top:18px;"><a href="/admin/books/new" class="btn btn-gold">+ Agregar libro</a></div>
    </div>
  <% } %>

  <!-- Modal de confirmación de eliminación -->
  <div class="modal-backdrop" id="delete-modal">
    <div class="modal-box">
      <h3>Eliminar libro del catálogo</h3>
      <p>Estás a punto de eliminar "<strong id="delete-book-title"></strong>" del catálogo digital de la escuela. Esta acción no se puede deshacer.</p>
      <form id="delete-form" method="POST">
        <div class="modal-actions">
          <button type="button" class="btn btn-outline" id="delete-cancel">Cancelar</button>
          <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer-admin') %>
  <script src="/js/admin.js"></script>
</body>
</html>
