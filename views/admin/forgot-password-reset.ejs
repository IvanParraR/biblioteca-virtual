<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Nueva contraseña</h1>
      <p class="login-sub">Paso 3 de 3 · Respuesta verificada correctamente.</p>

      <% if (typeof formErrorMsg !== 'undefined' && formErrorMsg) { %>
        <div class="alert alert-error"><%= formErrorMsg %></div>
      <% } %>

      <form action="/admin/forgot-password/reset" method="POST">
        <input type="hidden" name="username" value="<%= username %>">
        <div class="field" style="margin-bottom:14px;">
          <label for="password">Nueva contraseña</label>
          <input type="password" id="password" name="password" required minlength="8" autofocus placeholder="Mínimo 8 caracteres">
        </div>
        <div class="field" style="margin-bottom:22px;">
          <label for="confirm_password">Confirmar contraseña</label>
          <input type="password" id="confirm_password" name="confirm_password" required minlength="8">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Guardar nueva contraseña</button>
      </form>
    </div>
  </div>
</body>
</html>
