<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav-admin') %>

  <div class="admin-page-head">
    <div>
      <h1 style="margin-bottom:2px;">Agregar libro</h1>
      <p style="color:var(--ink-600); font-size:0.9rem;">Completa la información para añadirlo al catálogo digital.</p>
    </div>
  </div>

  <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

  <div class="form-card">
    <form action="/admin/books" method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="field field-full">
          <label for="title">Título *</label>
          <input type="text" id="title" name="title" required placeholder="Ej. El Principito">
        </div>
        <div class="field">
          <label for="author">Autor *</label>
          <input type="text" id="author" name="author" required placeholder="Ej. Antoine de Saint-Exupéry">
        </div>
        <div class="field">
          <label for="isbn">ISBN *</label>
          <input type="text" id="isbn" name="isbn" required placeholder="Ej. 9780156012195">
        </div>
        <div class="field">
          <label for="category">Categoría *</label>
          <input type="text" id="category" name="category" required list="cat-list" placeholder="Ej. Literatura">
          <datalist id="cat-list">
            <% categories.forEach(c => { %><option value="<%= c.category %>"><% }) %>
          </datalist>
        </div>
        <div class="field">
          <label for="publisher">Editorial</label>
          <input type="text" id="publisher" name="publisher" placeholder="Ej. Reynal & Hitchcock">
        </div>
        <div class="field">
          <label for="publication_year">Año de publicación</label>
          <input type="number" id="publication_year" name="publication_year" min="1400" max="2100" placeholder="Ej. 1943">
        </div>
        <div class="field">
          <label for="total_copies">Número de copias *</label>
          <input type="number" id="total_copies" name="total_copies" min="1" value="1" required>
        </div>
        <div class="field field-full">
          <label for="location">Ubicación en la biblioteca</label>
          <input type="text" id="location" name="location" placeholder="Ej. Estante L-12, Sección Literatura">
        </div>
        <div class="field field-full">
          <label for="description">Descripción</label>
          <textarea id="description" name="description" placeholder="Breve resumen o sinopsis del libro…"></textarea>
        </div>
        <div class="field field-full">
          <label for="cover">Portada</label>
          <input type="file" id="cover" name="cover" accept="image/*">
          <span class="field-hint">JPG, PNG, WEBP o SVG — máximo 5MB.</span>
        </div>
        <div class="field field-full checkbox-field">
          <input type="checkbox" id="library_only" name="library_only">
          <label for="library_only" style="text-transform:none;">Solo consulta en biblioteca (no circula / no se presta)</label>
        </div>
      </div>

      <div style="display:flex; gap:10px; margin-top:26px;">
        <button type="submit" class="btn btn-gold">Guardar libro</button>
        <a href="/admin/books" class="btn btn-outline">Cancelar</a>
      </div>
    </form>
  </div>

  <%- include('../partials/footer-admin') %>
</body>
</html>
