<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Pregunta de seguridad</h1>
      <p class="login-sub">Paso 2 de 3 · Usuario: <strong><%= username %></strong></p>

      <% if (typeof formErrorMsg !== 'undefined' && formErrorMsg) { %>
        <div class="alert alert-error"><%= formErrorMsg %></div>
      <% } %>

      <form action="/admin/forgot-password/verify" method="POST">
        <input type="hidden" name="username" value="<%= username %>">
        <input type="hidden" name="question" value="<%= question %>">
        <div class="field" style="margin-bottom:10px;">
          <label><%= question %></label>
        </div>
        <div class="field" style="margin-bottom:22px;">
          <label for="answer">Tu respuesta</label>
          <input type="text" id="answer" name="answer" required autofocus>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Verificar respuesta</button>
      </form>

      <p style="text-align:center; margin-top:18px; font-size:0.82rem;">
        <a href="/admin/login" style="color:var(--forest-700); font-weight:600;">← Volver a iniciar sesión</a>
      </p>
    </div>
  </div>
</body>
</html>
