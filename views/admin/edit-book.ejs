<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav-admin') %>

  <div class="admin-page-head">
    <div>
      <h1 style="margin-bottom:2px;">Editar libro</h1>
      <p style="color:var(--ink-600); font-size:0.9rem;"><%= book.title %></p>
    </div>
  </div>

  <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

  <div class="form-card">
    <form action="/admin/books/<%= book.id %>" method="POST" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="field field-full">
          <label for="title">Título *</label>
          <input type="text" id="title" name="title" required value="<%= book.title %>">
        </div>
        <div class="field">
          <label for="author">Autor *</label>
          <input type="text" id="author" name="author" required value="<%= book.author %>">
        </div>
        <div class="field">
          <label for="isbn">ISBN *</label>
          <input type="text" id="isbn" name="isbn" required value="<%= book.isbn %>">
        </div>
        <div class="field">
          <label for="category">Categoría *</label>
          <input type="text" id="category" name="category" required list="cat-list" value="<%= book.category %>">
          <datalist id="cat-list">
            <% categories.forEach(c => { %><option value="<%= c.category %>"><% }) %>
          </datalist>
        </div>
        <div class="field">
          <label for="publisher">Editorial</label>
          <input type="text" id="publisher" name="publisher" value="<%= book.publisher || '' %>">
        </div>
        <div class="field">
          <label for="publication_year">Año de publicación</label>
          <input type="number" id="publication_year" name="publication_year" min="1400" max="2100" value="<%= book.publication_year || '' %>">
        </div>
        <div class="field field-full">
          <label for="location">Ubicación en la biblioteca</label>
          <input type="text" id="location" name="location" value="<%= book.location || '' %>">
        </div>
        <div class="field field-full">
          <label for="description">Descripción</label>
          <textarea id="description" name="description"><%= book.description || '' %></textarea>
        </div>
        <div class="field field-full">
          <label>Portada actual</label>
          <div style="display:flex; align-items:center; gap:16px;">
            <div class="table-cover" style="width:60px; height:84px;">
              <% if (book.cover_url) { %><img src="<%= book.cover_url %>" alt=""><% } %>
            </div>
            <div style="flex:1;">
              <input type="file" id="cover" name="cover" accept="image/*">
              <span class="field-hint">Sube una imagen para reemplazar la portada actual.</span>
            </div>
          </div>
        </div>
        <div class="field field-full checkbox-field">
          <input type="checkbox" id="library_only" name="library_only" <%= book.library_only == 1 ? 'checked' : '' %>>
          <label for="library_only" style="text-transform:none;">Solo consulta en biblioteca (no circula / no se presta)</label>
        </div>
      </div>

      <div style="background:var(--paper); border:1px solid var(--line); border-radius:var(--radius-sm); padding:14px 16px; margin-top:18px; font-size:0.85rem; color:var(--ink-600);">
        Copias totales: <strong><%= book.total_copies %></strong> · Disponibles: <strong><%= book.available_copies %></strong>.
        Para cambiar el número de copias, usa los botones <strong>+1 / -1</strong> en la tabla de libros.
      </div>

      <div style="display:flex; gap:10px; margin-top:22px;">
        <button type="submit" class="btn btn-gold">Guardar cambios</button>
        <a href="/admin/books" class="btn btn-outline">Cancelar</a>
      </div>
    </form>
  </div>

  <%- include('../partials/footer-admin') %>
</body>
</html>
