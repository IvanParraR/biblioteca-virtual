<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav-admin') %>

  <div class="admin-page-head">
    <div>
      <h1 style="margin-bottom:2px;">Información general</h1>
      <p style="color:var(--ink-600); font-size:0.9rem;">Presentación, bienvenida, contacto y apariencia del sitio.</p>
    </div>
  </div>

  <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>
  <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

  <form action="/admin/settings" method="POST" enctype="multipart/form-data">

    <!-- 1. Presentación del sitio -->
    <div class="form-card" style="margin-bottom:24px;">
      <h2 style="font-size:1.05rem; margin-bottom:16px;">1. Presentación del sitio</h2>
      <div class="form-grid">
        <div class="field field-full">
          <label>Logo actual</label>
          <div style="display:flex; align-items:center; gap:16px;">
            <div style="width:64px; height:64px; border-radius:50%; background:var(--forest-800); display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;">
              <% if (settings.logo_url) { %>
                <img src="<%= settings.logo_url %>" alt="Logo actual" style="width:100%; height:100%; object-fit:contain;">
              <% } else { %>
                <span style="color:var(--gold-500); font-family:var(--font-display); font-weight:700; font-size:1.4rem;">B</span>
              <% } %>
            </div>
            <div style="flex:1;">
              <input type="file" name="logo" accept="image/*">
              <span class="field-hint">JPG, PNG, WEBP o SVG. Se redimensiona automáticamente. Ideal: imagen cuadrada con fondo transparente.</span>
            </div>
          </div>
        </div>
        <div class="field">
          <label for="school_name">Nombre de la institución *</label>
          <input type="text" id="school_name" name="school_name" required maxlength="150" value="<%= settings.school_name %>">
        </div>
        <div class="field">
          <label for="library_name">Nombre de la biblioteca *</label>
          <input type="text" id="library_name" name="library_name" required maxlength="150" value="<%= settings.library_name %>">
        </div>
      </div>
    </div>

    <!-- 2. Paleta de colores -->
    <div class="form-card" style="margin-bottom:24px;">
      <h2 style="font-size:1.05rem; margin-bottom:6px;">2. Color de acento del tema</h2>
      <p class="field-hint" style="margin-bottom:14px;">Cambia la paleta de todo el sitio (estudiante y panel) al instante.</p>
      <div class="palette-picker">
        <% Object.entries(palettes).forEach(([key, p]) => { %>
          <label class="palette-option <%= settings.color_palette === key ? 'selected' : '' %>">
            <input type="radio" name="color_palette" value="<%= key %>" <%= settings.color_palette === key ? 'checked' : '' %>>
            <span class="palette-swatches">
              <span class="swatch" style="background:<%= p.swatchPrimary %>;"></span>
              <span class="swatch" style="background:<%= p.swatchAccent %>;"></span>
            </span>
            <span class="palette-name"><%= p.name %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- 3. Mensaje de bienvenida -->
    <div class="form-card" style="margin-bottom:24px;">
      <h2 style="font-size:1.05rem; margin-bottom:6px;">3. Mensaje de bienvenida (página de inicio)</h2>
      <p class="field-hint" style="margin-bottom:14px;">Si los dejas vacíos, se muestra el mensaje predeterminado.</p>
      <div class="form-grid">
        <div class="field field-full">
          <label for="welcome_title">Título</label>
          <input type="text" id="welcome_title" name="welcome_title" maxlength="255" value="<%= settings.welcome_title || '' %>" placeholder="Ej. Encuentra tu próximo libro favorito">
        </div>
        <div class="field field-full">
          <label for="welcome_message">Bajada / descripción</label>
          <textarea id="welcome_message" name="welcome_message" maxlength="500" placeholder="Ej. Busca por título, autor o categoría y descubre todo lo que la biblioteca tiene para ti."><%= settings.welcome_message || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- 4. Contacto y horario -->
    <div class="form-card" style="margin-bottom:24px;">
      <h2 style="font-size:1.05rem; margin-bottom:6px;">4. Información de contacto y horario</h2>
      <p class="field-hint" style="margin-bottom:14px;">Se muestra en el pie de página del sitio de estudiantes. Deja en blanco lo que no aplique.</p>
      <div class="form-grid">
        <div class="field field-full">
          <label for="address">Dirección</label>
          <input type="text" id="address" name="address" maxlength="255" value="<%= settings.address || '' %>" placeholder="Ej. Calle 10 #5-20">
        </div>
        <div class="field">
          <label for="city">Ciudad</label>
          <input type="text" id="city" name="city" maxlength="150" value="<%= settings.city || '' %>" placeholder="Ej. Fundación, Magdalena">
        </div>
        <div class="field">
          <label for="phone">Teléfono</label>
          <input type="text" id="phone" name="phone" maxlength="50" value="<%= settings.phone || '' %>" placeholder="Ej. +57 300 123 4567">
        </div>
        <div class="field">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" maxlength="150" value="<%= settings.email || '' %>" placeholder="Ej. biblioteca@colegio.edu.co">
        </div>
        <div class="field">
          <label for="hours">Horario de atención</label>
          <input type="text" id="hours" name="hours" maxlength="255" value="<%= settings.hours || '' %>" placeholder="Ej. Lunes a viernes, 7:00 am – 3:00 pm">
        </div>
      </div>

      <h3 style="font-size:0.92rem; margin:20px 0 12px; color:var(--forest-800);">Redes sociales</h3>
      <div class="form-grid">
        <div class="field">
          <label for="social_facebook">Facebook</label>
          <input type="url" id="social_facebook" name="social_facebook" value="<%= settings.social_facebook || '' %>" placeholder="https://facebook.com/...">
        </div>
        <div class="field">
          <label for="social_instagram">Instagram</label>
          <input type="url" id="social_instagram" name="social_instagram" value="<%= settings.social_instagram || '' %>" placeholder="https://instagram.com/...">
        </div>
        <div class="field">
          <label for="social_twitter">X / Twitter</label>
          <input type="url" id="social_twitter" name="social_twitter" value="<%= settings.social_twitter || '' %>" placeholder="https://x.com/...">
        </div>
        <div class="field">
          <label for="social_whatsapp">WhatsApp</label>
          <input type="url" id="social_whatsapp" name="social_whatsapp" value="<%= settings.social_whatsapp || '' %>" placeholder="https://wa.me/573001234567">
        </div>
      </div>
    </div>

    <!-- 5. Modo mantenimiento -->
    <div class="form-card" style="margin-bottom:24px;">
      <h2 style="font-size:1.05rem; margin-bottom:6px;">5. Modo mantenimiento</h2>
      <p class="field-hint" style="margin-bottom:14px;">Muestra un aviso a los estudiantes ("catálogo en actualización") sin bloquear el acceso ni afectar el panel de administración.</p>
      <div class="checkbox-field">
        <input type="checkbox" id="maintenance_mode" name="maintenance_mode" <%= settings.maintenance_mode ? 'checked' : '' %>>
        <label for="maintenance_mode" style="text-transform:none;">Mostrar aviso de mantenimiento a los estudiantes</label>
      </div>
    </div>

    <% if (settings.updated_by) { %>
      <p class="field-hint" style="margin-bottom:16px;">
        Última actualización por <strong><%= settings.updated_by %></strong>
        <% if (settings.updated_at) { %> el <%= new Date(settings.updated_at).toLocaleString('es-ES') %><% } %>.
      </p>
    <% } %>

    <button type="submit" class="btn btn-gold">Guardar cambios</button>
  </form>

  <%- include('../partials/footer-admin') %>
</body>
</html>
