<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav-admin') %>

  <div class="admin-page-head">
    <div>
      <h1 style="margin-bottom:2px;">Administradores</h1>
      <p style="color:var(--ink-600); font-size:0.9rem;">Gestiona quién puede acceder al panel y quién puede administrar otras cuentas.</p>
    </div>
  </div>

  <% if (successMsg && successMsg.length) { %><div class="alert alert-success"><%= successMsg[0] %></div><% } %>
  <% if (errorMsg && errorMsg.length) { %><div class="alert alert-error"><%= errorMsg[0] %></div><% } %>

  <div class="table-wrap" style="margin-bottom:32px;">
    <table class="admin-table">
      <thead>
        <tr><th>Usuario</th><th>Nombre</th><th>Puede gestionar admins</th><th>Pregunta de seguridad</th><th>Creado</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        <% admins.forEach(a => { %>
          <tr>
            <td data-label="Usuario"><strong><%= a.username %></strong><% if (a.id === admin.id) { %> <span style="color:var(--gold-600); font-size:0.75rem;">(tú)</span><% } %></td>
            <td data-label="Nombre"><%= a.full_name || '—' %></td>
            <td data-label="Permiso">
              <span class="badge <%= a.can_manage_admins ? 'badge-disponible' : 'badge-no_disponible' %>">
                <%= a.can_manage_admins ? 'Sí, puede gestionar' : 'No' %>
              </span>
            </td>
            <td data-label="Pregunta de seguridad">
              <span class="badge <%= a.has_security_question ? 'badge-disponible' : 'badge-prestado' %>">
                <%= a.has_security_question ? 'Configurada' : 'Sin configurar' %>
              </span>
            </td>
            <td data-label="Creado"><%= new Date(a.created_at).toLocaleDateString('es-ES') %></td>
            <td data-label="Acciones">
              <div class="actions-cell">
                <form action="/admin/admins/<%= a.id %>/toggle-permission" method="POST" style="display:inline; margin:0;">
                  <button type="submit" class="btn btn-outline btn-sm">
                    <%= a.can_manage_admins ? 'Quitar permiso' : 'Dar permiso' %>
                  </button>
                </form>
                <% if (a.id !== admin.id) { %>
                  <form action="/admin/admins/<%= a.id %>/reset-temp-password" method="POST" style="display:inline; margin:0;"
                    onsubmit="return confirm('¿Asignar una contraseña temporal a &quot;<%= a.username %>&quot;? Esto reemplaza su contraseña actual de inmediato y le da acceso a quien tenga esa contraseña temporal hasta que la cambie. Compártela solo con el dueño real de la cuenta.');">
                    <button type="submit" class="btn btn-outline btn-sm">Contraseña temporal</button>
                  </form>
                  <button type="button" class="btn btn-danger btn-sm js-delete-trigger" data-title="<%= a.username %>" data-action="/admin/admins/<%= a.id %>/delete">Eliminar</button>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="form-card">
    <h2 style="font-size:1.05rem; margin-bottom:16px;">Crear nueva cuenta de administrador</h2>
    <form action="/admin/admins" method="POST">
      <div class="form-grid">
        <div class="field">
          <label for="username">Usuario *</label>
          <input type="text" id="username" name="username" required placeholder="Ej. maria.bibliotecaria">
        </div>
        <div class="field">
          <label for="full_name">Nombre completo</label>
          <input type="text" id="full_name" name="full_name" placeholder="Ej. María Gómez">
        </div>
        <div class="field field-full">
          <label for="password">Contraseña *</label>
          <input type="password" id="password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres">
        </div>
        <div class="field field-full checkbox-field">
          <input type="checkbox" id="can_manage_admins" name="can_manage_admins">
          <label for="can_manage_admins" style="text-transform:none;">Permitir que esta cuenta también gestione administradores</label>
        </div>
      </div>
      <p class="field-hint" style="margin-top:8px;">Por defecto, las nuevas cuentas NO pueden crear, editar permisos ni eliminar otras cuentas — solo gestionan el catálogo de libros.</p>
      <div style="margin-top:18px;">
        <button type="submit" class="btn btn-gold">Crear cuenta</button>
      </div>
    </form>
  </div>

  <!-- Modal de confirmación de eliminación (reutiliza el JS de admin.js) -->
  <div class="modal-backdrop" id="delete-modal">
    <div class="modal-box">
      <h3>Eliminar cuenta de administrador</h3>
      <p>Estás a punto de eliminar el acceso de "<strong id="delete-book-title"></strong>". Esta acción no se puede deshacer.</p>
      <form id="delete-form" method="POST">
        <div class="modal-actions">
          <button type="button" class="btn btn-outline" id="delete-cancel">Cancelar</button>
          <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer-admin') %>
  <script src="/js/admin.js"></script>
</body>
</html>
