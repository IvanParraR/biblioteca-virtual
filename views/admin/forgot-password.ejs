<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand-mark">B</div>
      <h1>Recuperar contraseña</h1>
      <p class="login-sub">Paso 1 de 3 · Responde tu pregunta de seguridad para definir una nueva contraseña.</p>

      <% if (errorMsg && errorMsg.length) { %>
        <div class="alert alert-error"><%= errorMsg[0] %></div>
      <% } %>
      <% if (successMsg && successMsg.length) { %>
        <div class="alert alert-success"><%= successMsg[0] %></div>
      <% } %>

      <form action="/admin/forgot-password" method="POST">
        <div class="field" style="margin-bottom:22px;">
          <label for="username">Usuario</label>
          <input type="text" id="username" name="username" required autofocus placeholder="Tu nombre de usuario">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Continuar</button>
      </form>

      <p style="text-align:center; margin-top:18px; font-size:0.82rem; color:var(--ink-400);">
        ¿No configuraste una pregunta de seguridad o no la recuerdas?<br>
        Pide a un administrador con permiso de gestión que te asigne una contraseña temporal.
      </p>

      <p style="text-align:center; margin-top:14px; font-size:0.82rem;">
        <a href="/admin/login" style="color:var(--forest-700); font-weight:600;">← Volver a iniciar sesión</a>
      </p>
    </div>
  </div>
</body>
</html>
