# Configuración de la base de datos MySQL del colegio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_virtual

# Sesión
SESSION_SECRET=cambia-esta-clave-por-una-segura

# Servidor
PORT=3000

# Nombre de respaldo, solo se usa si la tabla site_settings no existe
# todavía. Una vez migrada la base de datos, cambia el nombre desde
# Panel de administración → Configuración (solo gestores), no aquí.
SCHOOL_NAME=Colegio San Martín

# URL pública real de la app (para armar enlaces de confirmación de
# cuenta y de recuperación de contraseña en los correos). En local
# puedes dejarla vacía — se usa el host de la petición como respaldo.
# En Railway, pon la URL que te da Settings → Networking, ej.:
# APP_URL=https://biblioteca-virtual-production.up.railway.app
APP_URL=

# Envío de correos (confirmación de cuenta nueva, contraseña
# temporal). Si dejas esto vacío, los correos se imprimen en la
# consola del servidor en vez de enviarse de verdad — útil para
# probar el flujo completo sin depender de un proveedor real todavía.
# Con Gmail: activa verificación en 2 pasos y genera una "contraseña
# de aplicación" en https://myaccount.google.com/apppasswords (NO
# uses la contraseña normal de la cuenta).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SOLO PARA DIAGNÓSTICO LOCAL — si te sale "self-signed certificate
# in certificate chain" (típico de un antivirus o proxy que
# intercepta el tráfico HTTPS de tu máquina), puedes descomentar
# esto temporalmente para confirmar que es eso. Quítalo de nuevo en
# cuanto termines — nunca lo actives en Railway ni en producción.
# SMTP_INSECURE_SKIP_TLS_VERIFY=true
