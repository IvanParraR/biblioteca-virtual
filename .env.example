# Configuración de la base de datos MySQL del colegio
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_virtual

# Sesión
SESSION_SECRET=cambia-esta-clave-por-una-segura

# Servidor
PORT=3000

# Nombre de respaldo, solo se usa si la tabla site_settings no existe
# todavía. Una vez migrada la base de datos, cambia el nombre desde
# Panel de administración → Configuración (solo gestores), no aquí.
SCHOOL_NAME=Colegio San Martín

# URL pública real de la app (para armar enlaces de confirmación de
# cuenta y de recuperación de contraseña en los correos). En local
# puedes dejarla vacía — se usa el host de la petición como respaldo.
# En Railway, pon la URL que te da Settings → Networking, ej.:
# APP_URL=https://biblioteca-virtual-production.up.railway.app
APP_URL=

# Envío de correos (confirmación de cuenta nueva, contraseña
# temporal, etc.) — usa la API HTTP de Brevo, NO SMTP: Railway
# bloquea SMTP saliente en el plan Hobby, así que SMTP nunca
# funcionaría ahí sin importar el proveedor. La API de Brevo viaja
# por HTTPS, que sí funciona.
#
# Si dejas esto vacío, los correos se imprimen en la consola del
# servidor en vez de enviarse de verdad — útil para probar el flujo
# completo sin depender de una cuenta real todavía.
#
# BREVO_API_KEY: brevo.com → Settings → SMTP & API → pestaña "API" →
#   "Generate a new API key" (NO es la SMTP key, es una distinta).
# EMAIL_FROM: el correo remitente — tiene que estar verificado en
#   Brevo primero (Senders, Domains & Dedicated IPs → Senders → Add
#   a sender, te llega un correo de confirmación a esa dirección).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Biblioteca Virtual

# Fuentes Abiertas — clave de OpenAlex (opcional pero MUY recomendada
# desde 2026: sin ella, las búsquedas de artículos científicos caen
# seguido en "429 rate limit exceeded"). Gratis e instantánea en
# https://openalex.org/rest-api — solo hace falta un correo.
OPENALEX_API_KEY=
